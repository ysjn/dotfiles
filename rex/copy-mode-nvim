#!/bin/bash
# Load the usual Neovim config while preserving the viewer's remaining arguments.
nvim_arguments=()
while [ "$#" -gt 0 ]; do
  if [ "$1" = "-u" ] && [ "${2-}" = "NONE" ]; then
    shift 2
  else
    nvim_arguments+=("$1")
    shift
  fi
done

# Buffer-local overrides keep cancellation scoped to the copy-mode viewer.
exec /opt/homebrew/bin/nvim "${nvim_arguments[@]}" \
  -c 'lua for _, key in ipairs({ "q", "<Esc>" }) do vim.keymap.set({ "n", "x", "t" }, key, "<Cmd>qa!<CR>", { buffer = true, silent = true }) end'
